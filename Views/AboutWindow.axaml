<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VAMedicalCallClient.ViewModels"
        x:Class="VAMedicalCallClient.Views.AboutWindow"		
        x:DataType="vm:AboutWindowViewModel"        
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        CanResize="False">

	<Design.DataContext>
		<vm:AboutWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<Style Selector="TextBlock.email:pointerover">
			<Setter Property="Background" Value="#F0F8FF"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto" Margin="20">

		<!-- ================= Row 0: Заголовок окна ================= -->
		<StackPanel Grid.Row="0" Spacing="10">
			<TextBlock Text="О ПРОГРАММЕ"
					   FontSize="18"
					   FontWeight="Bold"
					   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Border BorderBrush="{DynamicResource SystemControlGridLinesBaseMediumLowBrush}" BorderThickness="0,0,0,1" />
		</StackPanel>

		<!-- ================= Row 1: Контент (Логотип + Инфо) ================= -->
		<Grid Grid.Row="1" ColumnDefinitions="210,*" Margin="0,15,0,15">

			<!-- Левая колонка (Column 0): Контейнер для логотипа -->
			<Panel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
				<Rectangle Width="200" Height="165" RadiusX="4" RadiusY="4"/>  
				
				<Image Width="200"
					   Height="165"
					   Source="/Assets/vamcc-about.png"
					   Stretch="Uniform"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"/>
			</Panel>

			<!-- Правая колонка (Column 1): Информационный блок -->
			<StackPanel Grid.Column="1" 
						Margin="15,0,0,0"
						VerticalAlignment="Center"
						HorizontalAlignment="Stretch"
						Spacing="2">

				<!-- Название приложения -->
				<TextBlock FontSize="26"
						   FontWeight="Bold"
						   HorizontalAlignment="Center">
					<Run Foreground="#FF0000">VA</Run>
					<Run Foreground="#3498DB">MedCall</Run>
				</TextBlock>

				<!-- Версии -->
				<TextBlock Text="{Binding MajorVersion}"
						   HorizontalAlignment="Center"
						   FontWeight="Bold"
						   FontSize="14"
						   Margin="0,5,0,2"/>

				<TextBlock Text="{Binding BuildVersion}"
						   HorizontalAlignment="Center"
						   FontSize="12"
						   Opacity="0.7"/>

				<!-- Технологический стек -->
				<TextBlock Text="C# Avalonia ReactiveUI MVVM"
						   HorizontalAlignment="Center"
						   FontSize="10"
						   Opacity="0.5"
						   Margin="0,0,0,10"/>

				<!-- Описание -->
				<TextBlock Text="{StaticResource APPDescription}"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   FontSize="13"
						   TextWrapping="Wrap"/>

				<!-- Контакты разработчика -->
				<TextBlock Text="{Binding DeveloperEmail}"
						   Classes="email"
						   HorizontalAlignment="Center"
						   FontSize="12"
						   Margin="0,10,0,0"/>
			</StackPanel> 
		</Grid>

		<!-- ================= Row 2: Нижняя панель с кнопкой закрытия ================= -->		
		<Border Grid.Row="2"
				BorderBrush="{DynamicResource SystemControlGridLinesBaseMediumLowBrush}"
				BorderThickness="0,1,0,0"
				Padding="0,15,0,0">
			
			<Button Content="OK"
					Width="95"
					Height="32"
					IsDefault="True"
					Command="{Binding CloseWindowCommand}"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					HorizontalAlignment="Right"/>
		</Border>
	</Grid>
</Window>
